 "plantuml": "@startuml\n!theme plain\npackage SimpleAirlineDomain {\nclass Airport {\n\t name : String\n}\nAirport \"departingFlight 0..*\" -- \"origin 1..1\" Flight\nAirport \"arrivingFlight 0..*\" -- \"destination 1..1\" Flight\nclass Flight {\n\t maxnrPassengers : Integer\n}\nFlight \"departTime 1..1\" --> Time\nFlight \"duration 1..1\" --> Time\nFlight \"passenger 0..*\" -- \"flight 1..1\" Passenger\nFlight \"airline 1..1\" -- \"flight 0..*\" Airline\nclass Airline {\n\t name : String\n\t nationality : String\n}\nclass Passenger {\n\t name : String\n\t age : Integer\n\t gender : Genre\n\t needsAssistance : Boolean\n}\nenum Genre {\nmale\nfemale\n}\nclass Time {\n\t year : Integer\n\t month : Integer\n\t day : Integer\n\t hour : Integer\n\t minute : Integer\n\t second : Integer\n}\n}\n@enduml\n"
