User "0..*" -- "1" RecyclingFacility : has
Admin "1" -- "0..*" RecyclingFacility : manages
Employee "0..*" -- "1" RecyclingFacility : worksAt
Superuser "1" -- "0..*" RecyclingFacility : manages
Admin "1" -- "0..*" User : manages
