@startuml
skinparam shadowing false
hide empty members
class Company {
  name : String
  phoneNumber : String
  address : String
  state : String
  zipCode : String
  website : String
  companyType : String
  taxStatus : String
}
class Contact {
  firstName : String
  lastName : String
  primaryPhoneNumber : String
  secondaryPhoneNumber : String
  email : String
  jobTitle : String
  notes : String
}
class Employee {
  firstName : String
  lastName : String
  primaryPhoneNumber : String
  secondaryPhoneNumber : String
  jobTitle : String
  email : String
  title : String
  +assignSupervisor()
}
class Product {
  code : String
  name : String
  description : String
  unitCost : double
  retailPrice : double
  category : String
  discontinued : boolean
  vendor : String
  +addVendor()
}
class ProductCategory {
  name : String
  code : String
  description : String
  image : String
}
class StockTake {
  date : LocalDate
  product : String
  quantityOnHand : int
  expectedQuantity : int
  +calculateDiscrepancy()
}
class Order {
  date : LocalDate
  customer : String
  employee : String
  status : String
  shipper : String
  taxRate : double
  taxStatus : String
  invoiceDate : LocalDate
  paymentMethod : String
  paymentDate : LocalDate
  details : String
  +addDetail()
}
class OrderDetail {
  product : String
  quantity : int
  unitPrice : double
  discount : double
  status : String
  +updateStatus()
}
class PurchaseOrder {
  date : LocalDate
  vendor : String
  employeeSubmitted : String
  employeeApproved : String
  status : String
  details : String
  +addDetail()
}
class PurchaseOrderDetail {
  product : String
  quantity : int
  unitPrice : double
}
class Customer {
  name : String
  phoneNumber : String
  address : String
  state : String
  zipCode : String
  website : String
  companyType : String
  taxStatus : String
  contacts : String
}
class Vendor {
  name : String
  phoneNumber : String
  address : String
  state : String
  zipCode : String
  website : String
  companyType : String
  taxStatus : String
  contacts : String
}
class Shipper {
  name : String
  phoneNumber : String
  address : String
  state : String
  zipCode : String
  website : String
  companyType : String
  taxStatus : String
  contacts : String
}
enum Title {
  MANAGER
  SUPERVISOR
  EMPLOYEE
}
enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}
enum POStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}
enum DetailStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}
Customer --|> Company
Vendor --|> Company
Shipper --|> Company
Company "0..*" -- "1" Contact : has
Employee "1" -- "1" Title : has
Product "1" -- "1" ProductCategory : is in
Order "1" -- "1" Customer : is for
Order "1" -- "1" Employee : is processed by
Order "1" -- "1" OrderStatus : has
Order "1" -- "1" Shipper : is shipped by
OrderDetail "1..*" -- "1" Order : is part of
PurchaseOrder "1" -- "1" Vendor : is for
PurchaseOrder "1" -- "1" Employee : is submitted by
PurchaseOrderDetail "1..*" -- "1" PurchaseOrder : is part of
@enduml