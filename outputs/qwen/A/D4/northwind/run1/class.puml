@startuml
skinparam shadowing false
hide empty members
class Company {
  name : String
  phoneNumber : String
  address : String
  state : String
  zipCode : String
  website : String
  companyType : String
  taxStatus : String
}
class Contact {
  firstName : String
  lastName : String
  primaryPhoneNumber : String
  secondaryPhoneNumber : String
  email : String
  jobTitle : String
  notes : String
}
class Employee {
  firstName : String
  lastName : String
  primaryPhoneNumber : String
  secondaryPhoneNumber : String
  jobTitle : String
  email : String
  title : String
  +assignSupervisor()
}
class Product {
  code : String
  name : String
  description : String
  unitCost : double
  retailPrice : double
  category : String
  discontinued : boolean
  vendor : String
}
class ProductCategory {
  name : String
  code : String
  description : String
  image : String
}
class StockTake {
  date : LocalDate
  product : String
  quantityOnHand : int
  expectedQuantity : int
}
class Order {
  date : LocalDate
  customer : String
  employee : String
  status : String
  shipper : String
  taxRate : double
  taxStatus : String
  invoiceDate : LocalDate
  paymentMethod : String
  paymentDate : LocalDate
  details : String
  +addDetail()
}
class OrderDetail {
  product : String
  quantity : int
  unitPrice : double
  discount : double
  status : String
}
class PurchaseOrder {
  date : LocalDate
  vendor : String
  submitter : String
  approver : String
  status : String
  +addDetail()
}
class PurchaseOrderDetail {
  product : String
  quantity : int
  unitPrice : double
}
class AuditLog {
  addedBy : String
  addedOn : LocalDate
  modifiedBy : String
  modifiedOn : LocalDate
}
Company "1" -- "0..*" Contact : has
PurchaseOrder "1" *-- "1..*" PurchaseOrderDetail : contains
Order "1" -- "1..*" OrderDetail : contains
Product "1" -- "1" ProductCategory : is in category
@enduml