@startuml
skinparam shadowing false
hide empty members
class Course {
  name : String
  credits : int
  +addProfessor()
  +addStudent()
  +createCourse()
}
class Professor {
  name : String
  +teachCourse()
}
class Student {
  name : String
  +enrollInCourse()
}
class Dormitory {
  price : double
  +accommodateStudent()
}
Course "1" o-- "0..*" Student : has
Course "1" -- "0..*" Professor : has
Dormitory "1" -- "0..4" Student : has
Student "0..*" -- "1" Course : enrolled_in
@enduml