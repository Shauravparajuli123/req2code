@startuml
skinparam shadowing false
hide empty members
class Course {
  name : String
  credits : int
  +addProfessor()
  +addStudent()
  +createCourse()
}
class Professor {
  name : String
  +teachCourse()
}
class Student {
  name : String
  +enrollInCourse()
}
class Dormitory {
  price : double
  +accommodateStudent()
}
Course "1" o-- "0..*" Student : has
Course "1" -- "0..*" Professor : has
Dormitory "1" -- "1..4" Student : has
Course "0..*" -- "0..*" Dormitory : can be located in
@enduml