@startuml
skinparam shadowing false
hide empty members
class News {
  title : String
  link : String
  author : String
  date : LocalDate
  newspaper : String
  +publishOn()
}
class Newspaper {
  language : String
  publicationDate : LocalDate
  news : String
  +publish()
}
Newspaper "1" -- "1..*" News : reports
Newspaper "1" *-- "1" News : includes
@enduml