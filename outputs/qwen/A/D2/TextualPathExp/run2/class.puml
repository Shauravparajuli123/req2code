@startuml
skinparam shadowing false
hide empty members
class TextualPathExp {
  path : String
}
class Path {
  transitions : String
}
class Transition {
}
class AlternativeTrans {
  name : String
  paths : String
}
class PrimitiveTrans {
  name : String
}
TextualPathExp "1" -- "1" Path : has
Path "1" -- "0..*" Transition : contains
Path "1" -- "1" AlternativeTrans : contains
TextualPathExp "1" *-- "1" Path : is composed of
Path "0..*" -- "0..*" PrimitiveTrans : contains
@enduml