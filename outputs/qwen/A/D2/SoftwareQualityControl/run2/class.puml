@startuml
skinparam shadowing false
hide empty members
class Date {
  day : int
  year : int
}
class Control {
  type : String
  date : LocalDate
  +createControl()
}
class ControlsSequence {
  controls : String
  +addControl()
}
enum ControlType {
  TYPE1
  TYPE2
  TYPE3
}
class Bug {
  number : int
  description : String
  originator : String
  comments : String
  closeDate : LocalDate
  +createBug()
}
class BugTracking {
  bugs : String
  +addBug()
}
class Architecture {
  +createArchitecture()
}
Control "1" -- "1..*" ControlsSequence : belongs to
Control "1" -- "1" ControlType : has
Bug "1" -- "1" BugTracking : is associated to
@enduml