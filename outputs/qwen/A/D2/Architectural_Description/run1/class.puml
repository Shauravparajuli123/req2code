@startuml
skinparam shadowing false
hide empty members
class ArchitectureDescription {
  +selectView()
}
class ArchitectureView {
  +conformToViewPoint()
  +projectOntoMainView()
}
class ArchitectureViewPoint {
  +defineView()
}
class MainView {
  +projectOntoView()
}
ArchitectureDescription "1" -- "1..*" ArchitectureView : contains
ArchitectureDescription "1" *-- "1" ArchitectureViewPoint : defines
ArchitectureView "1..*" o-- "1" MainView : projects
ArchitectureViewPoint --|> ArchitectureView
@enduml