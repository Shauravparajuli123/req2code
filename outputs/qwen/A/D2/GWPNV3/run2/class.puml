@startuml
skinparam shadowing false
hide empty members
class PetriNet {
  name : String
  places : String
  transitions : String
  +addPlace()
  +addTransition()
}
class Place {
  name : String
  net : String
  +setNet()
}
class Transition {
  name : String
  net : String
  +setNet()
}
class PTArc {
  srcPlace : String
  dstTransition : String
}
class TPArc {
  srcTransition : String
  dstTransition : String
}
class Net {
  name : String
  places : String
  transitions : String
  +addPlace()
  +addTransition()
}
Net "1" *-- "0..1" Place : has
PetriNet "1" -- "0..*" Place : has
PetriNet "1" -- "1..*" Transition : has
Net "1" *-- "0..*" PTArc : has
Net "1" *-- "0..*" TPArc : has
PTArc "0..*" -- "1" Transition : has
TPArc "0..*" -- "1" Transition : has
@enduml