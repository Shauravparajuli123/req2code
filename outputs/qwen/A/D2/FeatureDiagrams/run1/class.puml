@startuml
skinparam shadowing false
hide empty members
class Node {
  description : String
  object_ : String
  attribute : String
  xorGroup : String
  orGroup : String
  nodes : String
  +addAttribute()
  +addXorGroup()
  +addOrGroup()
  +addChild()
}
class Attribute {
  description : String
  name : String
  key : boolean
}
class XORGroup {
  preliminary : boolean
}
class ORGroup {
  preliminary : boolean
}
Node "1" *-- "0..*" Attribute : has
Node "0..*" -- "0..*" XORGroup : has
Node "0..*" -- "0..*" ORGroup : has
XORGroup --|> Node
ORGroup --|> Node
@enduml