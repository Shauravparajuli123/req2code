@startuml
skinparam shadowing false
hide empty members
class Node {
  description : String
  name : String
  key : boolean
  attributes : String
  xorGroups : String
  orGroups : String
  +addAttribute()
  +addXorGroup()
  +addOrGroup()
}
class Attribute {
  description : String
  name : String
  node : String
}
class XORGroup {
  preliminary : boolean
}
class ORGroup {
  preliminary : boolean
}
Node "1" *-- "0..*" Attribute : has
Node "0..*" -- "0..*" XORGroup : has
Node "0..*" -- "0..*" ORGroup : has
@enduml