@startuml
skinparam shadowing false
hide empty members
class Attribute {
  key : String
}
class StringAttribute {
  value : String
}
class BooleanAttribute {
  value : boolean
}
class MapAttribute {
  entries : String
}
class MapEntry {
  key : String
  value : String
}
class ListAttribute {
  entries : String
}
class ListEntry {
  value : String
}
class LaunchConfiguration {
  attributes : String
  +addAttribute()
}
class Game {
  type : String
  +createGame()
}
LaunchConfiguration "0..*" -- "1" Attribute : has
MapAttribute "1" *-- "1..*" MapEntry : has
ListAttribute "1" *-- "1..*" ListEntry : has
@enduml