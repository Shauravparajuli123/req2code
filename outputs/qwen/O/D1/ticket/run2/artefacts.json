dBehavior(self):\n        raise NotImplementedError\n\n    def deductServiceFee(self):\n        raise NotImplementedError\n\n    def validateTicket(self):\n        raise NotImplementedError\n\n    def protectUser(self):\n        raise NotImplementedError\n\n    def haveReseller(self):\n        raise NotImplementedError\nclass Reseller:\n    def __init__(self, bankAccount):\n        self.bankAccount = bankAccount\n\n    def resellTicket(self):\n        raise NotImplementedError\n\n    def saveBankAccount(self):\n        raise NotImplementedError\nclass Address:\n    def __init__(self, street, city, state, zipCode):\n        self.street = street\n        self.city = city\n        self.state = state\n        self.zipCode = zipCode\nclass Preference:\n    def __init__(self, musicGenre, eventTypes):\n        self.musicGenre = musicGenre\n        self.eventTypes = eventTypes\nclass Date:\n    def __init__(self, day, month, year):\n        self.day = day\n        self.month = month\n        self.year = year\nclass Event:\n    def __init__(self, description, date, artist, venue, price, type):\n        self.description = description\n        self.date = date\n        self.artist = artist\n        self.venue = venue\n        self.price = price\n        self.type = type\n\n    def seeEvent(self):\n        raise NotImplementedError\nclass EventPage:\n    def __init__(self, event, links):\n        self.event = event\n        self.links = links\n\n    def findInformation(self):\n        raise NotImplementedError\n\n    def haveLink(self):\n        raise NotImplementedError\nclass Link:\n    def __init__(self, url):\n        self.url = url\nclass Cent:\n    def __init__(self, value):\n        self.value = value\nclass Venue:\n    def __init__(self, map):\n        self.map = map",
