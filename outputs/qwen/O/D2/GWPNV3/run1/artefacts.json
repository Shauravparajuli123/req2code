 "python": "class Net:\n    def __init__(self, name):\n        self.name = name\n        self.places = []\n        self.arcs = []\n    def add_place(self, place):\n        self.places.append(place)\n    def add_arc(self, arc):\n        self.arcs.append(arc)\n\nclass Place:\n    def __init__(self, name):\n        self.name = name\n        self.arcs = []\n    def add_arc(self, arc):\n        self.arcs.append(arc)\n\nclass Arc:\n    def __init__(self, name):\n        self.name = name\n        self.src = None\n        self.dst = None\n    def src(self):\n        raise NotImplementedError\n    def dst(self):\n        raise NotImplementedError\n\nclass Model:\n    def __init__(self):\n        self.nets = []\n    def add_net(self, net):\n        self.nets.append(net)\n\nclass Transition:\n    def __init__(self, name):\n        self.name = name\n        self.outgoing_arcs = []\n    def add_outgoing_arc(self, arc):\n        self.outgoing_arcs.append(arc)\n\nclass PTArc(Arc):\n    def __init__(self, name):\n        super().__init__(name)\n\nclass TPArc(Arc):\n    def __init__(self, name):\n        super().__init__(name)\n",
