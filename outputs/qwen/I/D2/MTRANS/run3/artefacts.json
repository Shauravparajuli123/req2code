 "python": "from typing import List, Optional\n\nclass MetaClass:\n    pass\n\nclass Expression:\n    def __init__(self, instruction: Instruction):\n        self.instruction = instruction\n\nclass Inheritance:\n    def __init__(self, rule: Rule):\n        self.rule = rule\n\nclass Instruction:\n    pass\n\nclass Module:\n    def __init__(self, name: str):\n        self.name = name\n\nclass MtransModel:\n    def __init__(self):\n        self.expressions: List[Expression] = []\n        self.inheritances: List[Inheritance] = []\n        self.instructions: List[Instruction] = []\n        self.metamodels: List[MetaClass] = []\n        self.modules: List[Module] = []\n        self.rules: List[Rule] = []\n        self.variables: List[Variable] = []\n        self.sections: List[str] = []\n\nclass Rule:\n    def __init__(self, name: str, module: Module, source: MetaClass):\n        self.name = name\n        self.module = module\n        self.source = source\n        self.sections: List[str] = []\n        self.abstract: bool = False\n\nclass Variable:\n    def __init__(self, name: str, rule: Rule):\n        self.name = name\n        self.rule = rule\n\nclass Section:\n    def __init__(self, kind: str):\n        self.kind = kind\n",
