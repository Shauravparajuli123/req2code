 "python": "from typing import Type, TypeVar\n\nT = TypeVar('T')\n\nclass Classifier:\n    pass\n\nclass PrimitiveDataType(Classifier):\n    def __init__(self, name: str):\n        self.name = name\n\nclass Type(Classifier):\n    pass\n\nclass Association:\n    def __init__(self, name: str, src: 'Class'):\n        self.name = name\n        self.src = src\n\nclass SimpleClass(Classifier):\n    def __init__(self, name: str, parent: 'SimpleClass' = None):\n        self.name = name\n        self.parent = parent\n\nclass Attribute:\n    def __init__(self, name: str, type_: Type):\n        self.name = name\n        self.type = type_\n",
