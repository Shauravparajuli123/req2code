 "python": "from typing import List, Optional\n\nclass Arc:\n    def __init__(self, source: 'Place', destination: 'Transition', weight: Optional[Weight] = None):\n        self.source = source\n        self.destination = destination\n        self.weight = weight\n\nclass Net:\n    def __init__(self):\n        self.places = []\n        self.transitions = []\n\nclass PetriNet(Net):\n    def __init__(self):\n        super().__init__()\n        self.places = []\n        self.transitions = []\n\nclass Place:\n    def __init__(self, net: PetriNet):\n        self.net = net\n        self.input_arcs = []\n\nclass Transition:\n    def __init__(self, net: PetriNet):\n        self.net = net\n        self.output_arcs = []\n\nclass PlaceTransitionArc(Arc):\n    def __init__(self, source: Place, destination: Transition):\n        super().__init__(source, destination)\n\nclass TransitionPlaceArc(Arc):\n    def __init__(self, source: Transition, destination: Place):\n        super().__init__(source, destination)\n\nclass Weight:\n    pass\n",
