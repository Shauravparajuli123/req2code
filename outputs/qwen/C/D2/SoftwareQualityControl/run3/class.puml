@startuml
skinparam shadowing false
hide empty members
class Date {
  day : int
  year : int
}
enum ControlType {
}
class Control {
  type : String
  +createControl()
}
class ControlsSequence {
  controls : String
  role : String
  +addControl()
}
class ControlsObject {
  role : String
}
class Bug {
  number : int
  description : String
  originator : String
  comments : String
  closeDate : LocalDate
  +createBug()
}
class BugTracking {
  bugs : String
  +addBug()
}
class Architecture {
}
Control "1" -- "1..*" ControlsSequence : is part of
Control "1" -- "1" ControlType : has type
Bug "1" -- "1" BugTracking : is tracked by
ControlsObject "1" -- "1" ControlsSequence : is part of
@enduml