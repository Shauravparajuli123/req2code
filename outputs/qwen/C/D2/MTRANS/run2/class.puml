@startuml
skinparam shadowing false
hide empty members
class MtransModel {
  name : String
  modules : String
  rules : String
  inheritances : String
  expressions : String
  sections : String
  variables : String
}
class Module {
  name : String
  rules : String
}
class Rule {
  name : String
  module : String
  source : String
  sections : String
  inheritances : String
  +addSection()
  +addInheritance()
}
class Section {
  kind : String
}
class Inheritance {
  rule : String
}
class Expression {
  instruction : String
}
class Instruction {
}
class Variable {
  name : String
}
MtransModel "1" -- "1..*" Module : has
Module "1" -- "1..*" Rule : has
Rule "1" -- "1..*" Section : has
Rule "1" -- "1..*" Variable : has
Expression "1" -- "1" Instruction : has
Instruction "1" -- "1" Expression : has
@enduml