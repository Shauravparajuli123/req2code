@startuml
skinparam shadowing false
hide empty members
class Airport {
  name : String
}
class Flight {
  name : String
  departureTime : String
  originAirport : String
  maxPassengers : int
  passengers : String
  +addPassenger()
  +createFlight()
}
class Passenger {
  name : String
  gender : String
  flight : String
  +assignToFlight()
}
Flight "0..*" -- "1" Passenger : has
Airport "1" -- "1" Flight : has
@enduml