skinparam shadowing false
hide empty members
class BusinessEntity {
  businessContact : String
  identifiers : String
  +addBusinessContact()
}
class Contact {
}
class IdentifierBag {
}
class Model {
  overviewDocuments : String
  +addOverviewDocument()
}
