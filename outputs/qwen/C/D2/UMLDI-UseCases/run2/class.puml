@startuml
skinparam shadowing false
hide empty members
class Instance {
  name : String
  +createInstance()
}
class AttributeLink {
  link : String
}
class Linkend {
  link : String
  instance : String
}
class Link {
  linkend : String
  instance : String
}
class Resident {
}
AttributeLink "0..1" *-- "1" Instance : has
AttributeLink "0..1" *-- "1" Linkend : has
Link "1" -- "1" Linkend : has
Linkend "1" -- "1" Instance : has
@enduml