@startuml
skinparam shadowing false
hide empty members
class Game {
  name : String
  +createGame()
}
class StateMachine {
  name : String
  rootFolder : String
  +addTransition()
  +removeTransition()
}
class RootFolder {
  name : String
  subFolders : String
}
class State {
  stateMachine : String
}
class Transition {
  stateMachine : String
  +addAssociationState()
  +removeAssociationState()
}
class AssociationState {
  transition : String
  sourceStates : String
}
StateMachine "1" *-- "1" RootFolder : has
StateMachine "0..*" o-- "0..*" Transition : has
AssociationState --|> State
State "1" -- "1" StateMachine : has
State "1" -- "1..*" AssociationState : has
Transition "1" -- "1" StateMachine : has
@enduml