@startuml
skinparam shadowing false
hide empty members
class Net {
  name : String
  places : String
  arcs : String
}
class Place {
  name : String
  net : String
}
class Arc {
  src : String
  dst : String
}
class Transition {
  name : String
  net : String
  outgoingArcs : String
}
class PTArc {
  src : String
  dst : String
}
class TPArc {
  src : String
  dst : String
}
Net "1" -- "1..*" Place : has
Net "1" -- "0..*" TPArc : has
Net "1" -- "1" Transition : has
PTArc --|> Arc
TPArc --|> Arc
@enduml