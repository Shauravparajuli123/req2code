@startuml
skinparam shadowing false
hide empty members
class Node {
  identifier : String
  category : String
  taskType : String
  importance : int
  complexityLevel : int
  centrality : int
}
class Task {
  +decompose()
  +associateExpression()
  +associateOperator()
  +binaryOperator()
  +unaryOperator()
}
Task "1" -- "1" Node : is described by
Node "1" -- "1..*" Task : contains
Node "1" *-- "1" Task : describes
