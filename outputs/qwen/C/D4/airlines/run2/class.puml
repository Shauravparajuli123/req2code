@startuml
skinparam shadowing false
hide empty members
class Airline {
  name : String
  operatingCosts : String
  +addOperatingCost()
  +removeOperatingCost()
  +updateOperatingCost()
}
class Airport {
  code : String
  city : String
}
class OperatingCost {
  cost : double
  startDate : LocalDate
  endDate : LocalDate
}
Airline "1" -- "1..*" Airport : operates at
Airline "1" *-- "1" OperatingCost : has
Airport "0..*" o-- "1" OperatingCost : has
@enduml