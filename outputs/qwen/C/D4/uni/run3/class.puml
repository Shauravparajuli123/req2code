@startuml
skinparam shadowing false
hide empty members
class Course {
  name : String
  credits : int
  professors : String
  students : String
  +addProfessor()
  +addStudent()
}
class Dormitory {
  price : double
  students : String
  +addStudent()
}
class Professor {
  name : String
}
class Student {
  name : String
  +enrollInCourse()
}
Course "1" -- "1..*" Professor : has
Course "1" o-- "1..5" Student : aggregates
Student "0..*" -- "1" Dormitory : is accommodated in
@enduml