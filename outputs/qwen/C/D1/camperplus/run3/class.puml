@startuml
skinparam shadowing false
hide empty members
class Camper {
  name : String
  guardian : String
  emergencyInformation : String
  problem : String
  +createCamper()
  +deleteCamper()
  +modifyCamperInformation()
}
class Parent {
  name : String
  camperBehavior : String
  +createAccount()
  +submitConsentForm()
  +seeCamperActivity()
  +seeSchedule()
  +seeConsentForm()
  +seePayment()
  +sharePhoto()
}
class CampAdministrator {
  +createCamper()
  +deleteCamper()
  +keepCamperRecord()
  +keepInformation()
  +keepTrack()
  +logAttendance()
  +makeNametag()
  +modifyInformation()
  +modifyTask()
  +notifyParent()
  +provideFeedback()
  +removeCamper()
  +scheduleActivity()
  +scheduleTask()
  +seeCampGroup()
  +seeCamper()
  +seeConsentForm()
  +seeForm()
  +seePayment()
  +seeSchedule()
  +setReminder()
  +sharePhoto()
  +signConsentForm()
  +storeEmergencyInformation()
  +storeInformation()
  +submitCompletionReport()
  +uploadConsentForm()
  +warnCampWorker()
}
class CampWorker {
  +seeAssignedKids()
  +submitCompletionReport()
  +reportBehavior()
  +reportSupplies()
  +reportRepairs()
}
class Nametag {
  +createNametag()
}
class ConsentForm {
  +uploadConsentForm()
  +signConsentForm()
}
class Event {
  +scheduleEvent()
  +modifyEvent()
  +seeEvent()
}
class Task {
  +scheduleTask()
  +modifyTask()
}
class Group {
  +createGroup()
  +seeGroup()
}
CampAdministrator "1" -- "0..*" Camper : has
CampAdministrator "1" -- "0..*" Parent : has
CampAdministrator "1" -- "0..*" Event : has
CampAdministrator "1" -- "0..*" Task : has
CampAdministrator "1" -- "0..*" Group : has
CampAdministrator "1" -- "0..*" Nametag : has
CampAdministrator "1" -- "0..*" ConsentForm : has
CampAdministrator "1" -- "0..*" CampWorker : has
Parent "1" -- "0..*" Camper : has
Parent "1" -- "0..*" ConsentForm : has
CampWorker "1" -- "0..*" Camper : has
CampWorker "1" -- "0..*" Task : has
@enduml