@startuml
skinparam shadowing false
hide empty members
class Company {
  name : String
  phoneNumber : String
  address : String
  state : String
  zipCode : String
  website : String
  type : String
  taxStatus : String
  contacts : String
}
class Contact {
  firstName : String
  lastName : String
  primaryPhoneNumber : String
  secondaryPhoneNumber : String
  email : String
  jobTitle : String
  notes : String
}
class Employee {
  firstName : String
  lastName : String
  primaryPhoneNumber : String
  secondaryPhoneNumber : String
  jobTitle : String
  supervisor : String
  privileges : String
  +assignSupervisor()
  +addPrivilege()
}
class Product {
  code : String
  name : String
  description : String
  category : String
  unitCost : double
  retailPrice : double
  inventoryLevel : int
  reorderLevel : int
  targetLevel : int
  minReorderQuantity : int
  discontinued : boolean
}
class Order {
  date : LocalDate
  customer : String
  employee : String
  status : String
  shipper : String
  taxRate : double
  taxStatus : String
  invoiceDate : LocalDate
  paymentMethod : String
  paymentDate : LocalDate
  details : String
  +addDetail()
}
class OrderDetailItem {
  product : String
  quantity : int
  unitPrice : double
  discount : double
  status : String
}
class PurchaseOrder {
  date : LocalDate
  vendor : String
  submitter : String
  approver : String
  status : String
  details : String
}
class PurchaseOrderDetailItem {
  product : String
  quantity : int
  unitPrice : double
}
Company "0..*" -- "1" Contact : has
Order "1" -- "1" Employee : is processed by
PurchaseOrder "1" -- "1" Employee : is submitted by
@enduml