@startuml
skinparam shadowing false
hide empty members
class Company {
  name : String
  phoneNumber : String
  address : String
  state : String
  zipCode : String
  website : String
  companyType : String
  taxStatus : String
  contacts : String
  +addContact()
  +removeContact()
}
class Contact {
  firstName : String
  lastName : String
  primaryPhoneNumber : String
  secondaryPhoneNumber : String
  email : String
  jobTitle : String
  notes : String
}
class Customer {
}
class Vendor {
}
class Shipper {
}
class Employee {
  firstName : String
  lastName : String
  jobTitle : String
  phoneNumbers : String
  privileges : String
  +assignPrivilege()
  +removePrivilege()
}
class Order {
  orderDate : LocalDate
  customer : String
  employee : String
  status : String
  shipper : String
  taxRate : double
  taxStatus : String
  invoiceDate : LocalDate
  paymentMethod : String
  paymentDate : LocalDate
  orderDetails : String
  +addOrderDetail()
  +removeOrderDetail()
}
class OrderDetailItem {
  product : String
  quantity : int
  unitPrice : double
  discount : double
  status : String
}
class Product {
  code : String
  name : String
  description : String
  category : String
  unitCost : double
  retailPrice : double
  inventoryLevel : int
  reorderLevel : int
  targetLevel : int
  minReorderQuantity : int
  discontinued : boolean
}
class PurchaseOrder {
  orderDate : LocalDate
  vendor : String
  employee : String
  approvedBy : String
  status : String
  purchaseOrderDetails : String
  +addPurchaseOrderDetail()
  +removePurchaseOrderDetail()
}
class PurchaseOrderDetailItem {
  product : String
  quantity : int
  unitPrice : double
}
class ProductCategory {
  name : String
  code : String
  description : String
  image : String
}
enum CompanyType {
  CUSTOMER
  VENDOR
  SHIPPER
}
enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}
enum PurchaseOrderStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
  CANCELLED
}
enum OrderDetailStatus {
  PENDING
  PROCESSED
  SHIPPED
  DELIVERED
  CANCELLED
}
Customer --|> Company
Vendor --|> Company
Shipper --|> Company
Company "1" -- "1" CompanyType : has
Company "0..*" -- "1" Contact : has
Product "1" -- "1" ProductCategory : is in
Product "0..*" -- "1..*" Vendor : is supplied by
Order "1" -- "1" Customer : is for
Order "1" -- "1" Employee : is processed by
Order "1" -- "1" OrderStatus : has
Order "1" -- "1" Shipper : is shipped by
OrderDetailItem "1..*" -- "1" Order : is part of
PurchaseOrder "1" -- "1" Vendor : is for
PurchaseOrder "1" -- "1" Employee : is submitted by
PurchaseOrder "1" -- "1" PurchaseOrderStatus : has
@enduml