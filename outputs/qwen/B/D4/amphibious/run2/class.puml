@startuml
skinparam shadowing false
hide empty members
class Vehicle {
  position : String
  speed : int
  maxSpeed : int
  environment : String
  +move()
}
class LandVehicle {
}
class MarineVehicle {
}
class AmphibiousVehicle {
}
LandVehicle --|> Vehicle
MarineVehicle --|> Vehicle
Vehicle "0..1" -- "1" AmphibiousVehicle : can be
AmphibiousVehicle "1" -- "1" LandVehicle : is a
AmphibiousVehicle "1" -- "1" MarineVehicle : is a
@enduml