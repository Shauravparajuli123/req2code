@startuml
skinparam shadowing false
hide empty members
class Airline {
  name : String
  operations : String
  +startOperation()
  +stopOperation()
  +updateOperatingCost()
}
class Airport {
  code : String
  city : String
}
class OperatingCost {
  airline : String
  airport : String
  cost : double
}
Airline "1" -- "1..*" Airport : operates at
Airline "1" -- "1" OperatingCost : has
Airport "1" -- "1" OperatingCost : has
OperatingCost "1" o-- "1" Airport : is for
OperatingCost "1" o-- "1" Airline : is of
@enduml