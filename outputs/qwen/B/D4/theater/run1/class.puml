@startuml
skinparam shadowing false
hide empty members
class Theater {
  location : String
}
class Play {
  name : String
  day : boolean
  night : boolean
  theaters : String
  +createPlay()
}
class Author {
  name : String
  +writePlay()
}
class Participant {
  name : String
  +actInPlay()
}
class Session {
  beginTime : LocalDate
  endTime : LocalDate
  +actInSession()
}
Play "1..*" -- "1" Author : has
Play "1..*" -- "1..*" Participant : has
Play "1..*" -- "1..*" Session : has
Theater "0..*" -- "1..*" Play : hosts
Session "1..*" -- "1..*" Participant : has
@enduml