@startuml
skinparam shadowing false
hide empty members
class Place {
  name : String
  destination : String
}
class Transition {
  name : String
  net : String
  destination : String
  +createTransition()
}
class Net {
  name : String
  place : String
}
Net "1" -- "1..*" Place : has
Transition "1" -- "1" Net : has
Place "0..*" -- "1..*" Transition : has
@enduml