@startuml
skinparam shadowing false
hide empty members
class Place {
  name : String
  destination : String
}
class Transition {
  name : String
  net : String
  destination : String
  +createTransition()
}
class Net {
  name : String
  place : String
  +createNet()
}
Net "1" -- "1..*" Place : has
Transition "1" -- "1" Net : has
Transition "1" -- "1..*" Place : has
@enduml