@startuml
skinparam shadowing false
hide empty members
class TupleElement {
  value : String
}
class Tuple {
  +addTupleElement()
}
class Database {
  sgbdName : String
}
class Table {
  +addDatabase()
}
class RelationalDBcontent {
}
RelationalDBcontent "1" -- "0..*" Table : has
RelationalDBcontent "1" -- "0..*" Tuple : has
Database "1" *-- "1..*" Table : contains
Table "1" -- "1" Tuple : owns
Tuple "1" -- "1..*" TupleElement : contains
@enduml