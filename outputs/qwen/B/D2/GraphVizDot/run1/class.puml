@startuml
skinparam shadowing false
hide empty members
class Graph {
  type : String
  dimension : String
  elements : String
}
class GraphElement {
  name : String
  label : String
  zIndex : int
  parent : String
  +createElement()
}
class Node {
  shape : String
}
class DirectedArc {
  sourceNode : String
  targetNode : String
  shape : String
}
class Constraint {
  value : String
}
Graph "1" *-- "0..*" GraphElement : contains
GraphElement "0..*" -- "1" Node : has
GraphElement "0..*" -- "1" DirectedArc : has
GraphElement "1" -- "1" Graph : is-contained-in
@enduml