@startuml
skinparam shadowing false
hide empty members
class Graph {
  type : String
  dimension : int
}
class GraphElement {
  label : String
  zIndex : int
  parentGraph : String
  +createGraphElement()
}
class Node {
  shape : String
}
class DirectedArc {
  sourceNode : String
  targetNode : String
  shape : String
}
class Constraint {
  value : String
}
class SubGraph {
}
Graph "1" *-- "0..*" GraphElement : contains
GraphElement "1" -- "1" Node : is
GraphElement "1" -- "1" DirectedArc : is
Node "1" -- "1" Graph : is part of
DirectedArc "1" -- "1" Node : links
Graph "1" -- "0..*" SubGraph : contains
@enduml