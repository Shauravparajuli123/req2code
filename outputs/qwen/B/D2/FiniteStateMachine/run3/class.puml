@startuml
skinparam shadowing false
hide empty members
class Game {
  name : String
  +createGame()
}
class RootFolder {
  name : String
}
class StateMachine {
  rootFolder : String
}
class State {
  stateMachine : String
  associationStateSources : String
}
class AssociationState {
  transition : String
  sourceStates : String
}
class Transition {
  stateMachine : String
}
StateMachine "1" *-- "1" RootFolder : has
StateMachine "0..*" o-- "0..*" Transition : has
AssociationState --|> State
State "1" -- "1" StateMachine : has
Transition "0..*" -- "1" StateMachine : has
@enduml