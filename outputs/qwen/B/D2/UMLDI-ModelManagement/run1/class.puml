@startuml
skinparam shadowing false
hide empty members
class CoreModel {
  name : String
  isSpecification : boolean
}
class Element {
  name : String
  isRoot : boolean
  isAbstract : boolean
  generalizations : String
  +createElement()
}
class Namespace {
  name : String
}
class Classifier {
  name : String
  powerTypeRanges : String
  +createClassifier()
}
class Feature {
  name : String
  ownerScope : String
  +createFeature()
}
class Generalization {
  name : String
  discriminator : boolean
  parent : String
  child : String
  +createGeneralization()
}
class GeneralizableElement {
  name : String
  isRoot : boolean
  isAbstract : boolean
  generalizations : String
  +createGeneralizableElement()
}
CoreModel "1" -- "0..*" Classifier : contains
CoreModel "1" -- "0..*" Element : contains
CoreModel "1" -- "0..*" Generalization : contains
CoreModel "1" -- "0..*" Namespace : contains
@enduml