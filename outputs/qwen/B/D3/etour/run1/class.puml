  +researchHeritage()
}
class RegisteredUser {
  username : String
  password : String
  +supplyLogin()
  +endSession()
}
class AgencyOperator {
  username : String
  password : String
  +removeSearchTag()
  +askSearchTag()
  +insertTagSearch()
  +changePassword()
}
class RestaurantOperator {
  username : String
  password : String
  +insertBanner()
  +changeImage()
  +deleteBannerAd()
  +changeMenu()
  +deleteMenu()
  +changeDataPoint()
  +requireConvention()
}
class SearchTag {
  name : String
}
class TagSearch {
  name : String
}
class Banner {
  image : String
}
class Comment {
  text : String
  siteId : int
  +editComment()
}
class Gps {
  position : String
}
class Position {
  latitude : double
  longitude : double
}
class AdvancedSearch {
  criteria : String
}
class User {
  id : int
  username : String
}
Agency "1" -- "0..*" CulturalHeritage : manages
Agency "1" -- "0..*" RefreshmentPoint : manages
Agency "1" -- "0..*" TouristAccount : manages
Agency "1" -- "0..*" Site : has
Agency "1" -- "0..*" News : has
Agency "1" -- "0..*" Feedback : has
RestaurantOperator "1" -- "1" BannerAd : has
Tourist "0..*" -- "1" Site : visits
Site "0..*" -- "1" Feedback : receives
Tourist "0..*" -- "1" Feedback : gives
Gps "1" -- "1" Position : calculates
Tourist "1" -- "1" AdvancedSearch : uses
User "1" -- "0..*" Feedback : issues
@enduml