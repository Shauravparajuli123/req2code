@startuml
skinparam shadowing false
hide empty members
class Agency {
  +logIn()
  +logOut()
}
class CulturalHeritage {
  name : String
  description : String
  location : String
  +searchCulturalHeritage()
  +viewDetails()
  +viewHistory()
}
class RefreshmentPoint {
  name : String
  location : String
  type : String
  +searchRefreshmentPoint()
  +viewDetails()
  +viewHistory()
  +deleteRefreshmentPoint()
  +activateConvention()
  +editData()
  +checkBanners()
  +insertBanner()
  +deleteBanner()
}
class TouristAccount {
  username : String
  status : String
  email : String
  +searchTouristAccount()
  +viewDetails()
  +enableDisableAccount()
  +viewHistory()
}
class Tourist {
  name : String
  +searchTourist()
  +modifyData()
  +deleteAccount()
  +editSearchPreference()
  +editPersonalData()
  +editPreferences()
  +viewListFavorites()
  +viewListSites()
  +insertSite()
  +deleteSite()
  +insertFeedback()
}
class BannerAd {
  image : String
}
class News {
  title : String
  content : String
  +insertNews()
  +deleteNews()
  +modifyNews()
}
class Feedback {
  site : String
  comments : String
  text : String
  siteId : int
  +viewFeedback()
  +viewReport()
  +editComment()
}
class Site {
  name : String
  id : int
}
class GuestUser {
  name : String
  password : String
