    def seeOverview(self):\n        raise NotImplementedError\n    def seeSpot(self):\n        raise NotImplementedError\n    def bookSpot(self):\n        raise NotImplementedError\n    def callGym(self):\n        raise NotImplementedError\n    def receiveNotification(self):\n        raise NotImplementedError\n    def receivePushNotification(self):\n        raise NotImplementedError\n    def confirmBooking(self):\n        raise NotImplementedError\n    def logSystem(self):\n        raise NotImplementedError\n\nclass Admin:\n    def __init__(self):\n        pass\n    def addTrainer(self):\n        raise NotImplementedError\n    def addAdmin(self):\n        raise NotImplementedError\n    def removeTrainer(self):\n        raise NotImplementedError\n    def editTrainingSession(self):\n        raise NotImplementedError\n    def cancelLesson(self):\n        raise NotImplementedError\n\nclass Trainer:\n    def __init__(self):\n        self.lessons = []\n    def addLesson(self):\n        raise NotImplementedError\n    def setTime(self):\n        raise NotImplementedError\n    def setDescription(self):\n        raise NotImplementedError\n    def setRoom(self):\n        raise NotImplementedError\n    def setNumber(self):\n        raise NotImplementedError\n    def editLesson(self):\n        raise NotImplementedError\n    def editTime(self):\n        raise NotImplementedError\n    def editRoom(self):\n        raise NotImplementedError\n    def editDescription(self):\n        raise NotImplementedError\n    def editNumber(self):\n        raise NotImplementedError\n    def cancelLesson(self):\n        raise NotImplementedError\n\nclass Lesson:\n    def __init__(self, description: str, record: str, room: str, time: str):\n        self.description = description\n        self.record = record\n        self.room = room\n        self.time = time\n    def setTime(self):\n        raise NotImplementedError\n    def setDescription(self):\n        raise NotImplementedError\n    def setRoom(self):\n        raise NotImplementedError\n    def setNumber(self):\n        raise NotImplementedError\n\nclass Room:\n    def __init__(self, availability: bool):\n        self.availability = availability\n    def checkAvailability(self):\n        raise NotImplementedError\n\nclass Notification:\n    def __init__(self, method: str):\n        self.method = method\n    def sendNotification(self):\n        raise NotImplementedError\n    def sendPushNotification(self):\n        raise NotImplementedError\n\nclass Fine:\n    def __init__(self, amount: int, offense_count: int):\n        self.amount = amount\n        self.offense_count = offense_count\n    def issueFine(self):\n        raise NotImplementedError",
