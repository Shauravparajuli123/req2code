@startuml
skinparam shadowing false
hide empty members
class Customer {
  name : String
  personalInformation : String
  bankingDetails : String
  membershipType : String
  subscriptionDuration : int
  previousInformation : String
  password : String
  personalDetails : String
  paymentInformation : String
  familyMembers : String
  bookedLessons : String
  checkInStatus : boolean
  notificationMethod : String
  +openAccount()
  +addPersonalInformation()
  +addBankingDetails()
  +chooseMembershipType()
  +extendSubscription()
  +knowSubscriptionDuration()
  +usePreviousInformation()
  +unsubscribe()
  +resetPassword()
  +changePersonalDetails()
  +updatePaymentInformation()
  +addPersonToMembership()
  +removePersonFromMembership()
  +seeAvailableLessons()
  +seeBookedLessons()
  +seePastLessons()
  +callToBookLesson()
  +callToCancelLesson()
  +seeCustomerSubscriptions()
  +seeCustomerCheckIn()
  +seeCustomerBookings()
}
class Admin {
  name : String
  password : String
  +addTrainer()
  +addAdmin()
  +removeTrainer()
  +seeNoShows()
  +seeNoShowCount()
  +issueFine()
  +increaseFine()
  +seeCustomerSubscriptions()
}
class Trainer {
  name : String
  password : String
  lessons : String
  +addLesson()
  +setLessonTime()
  +setLessonDescription()
  +setLessonRoom()
  +setLessonType()
  +setLessonMaxPeople()
  +seeSchedule()
  +editLessonTime()
  +changeLessonRoom()
  +editLessonDescription()
  +editLessonMaxPeople()
  +editAnyLesson()
  +cancelLesson()
}
class Lesson {
  time : LocalDate
  description : String
  room : String
  type : String
  maxPeople : int
  trainer : String
  +setTime()
  +setDescription()
  +setRoom()
  +setType()
  +setMaxPeople()
}
Admin "1" -- "0..*" Customer : manages
Trainer "1" -- "1" Lesson : teaches
Admin "1" -- "0..*" Lesson : manages
Trainer "1" -- "1" Admin : reportsTo
Admin "1" -- "0..*" Trainer : manages
@enduml