@startuml
skinparam shadowing false
hide empty members
class Company {
  backOffice : String
  stores : String
  +createGame()
}
class CorporateHQ {
  stores : String
  +createGame()
}
class Store {
  cashRegisters : String
  +createGame()
}
class BackOffice {
  +createGame()
}
class CashRegister {
  +createGame()
}
Company "1" *-- "1" CorporateHQ : has
Company "1" o-- "0..*" Store : has
Company "1" -- "1" BackOffice : has
Company "1" -- "0..*" CashRegister : has
CorporateHQ "1" -- "0..*" Store : manages
Store "1" -- "1" BackOffice : has
Store "1" -- "0..*" CashRegister : has
@enduml