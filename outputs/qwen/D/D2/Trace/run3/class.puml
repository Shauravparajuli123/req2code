@startuml
skinparam shadowing false
hide empty members
class Trace {
  name : String
}
class Level {
  trace : String
  +addLevel()
}
class Call {
  methodName : String
  numberOfDatabaseRows : int
  level : String
  +createCall()
}
Call "1" -- "1" Level : has
Trace "0..*" -- "1" Level : has
@enduml