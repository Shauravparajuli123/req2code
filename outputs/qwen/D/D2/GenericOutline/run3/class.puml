@startuml
skinparam shadowing false
hide empty members
class LocatedElement {
  location : String
}
class Node {
  name : String
  icon : String
  +createNode()
}
class Label {
  label : String
  +createLabel()
}
class LabelSuite {
  label : String
  +createLabelSuite()
}
class Map {
  mapString : String
  +createMap()
}
Node "1" *-- "1" Label : has
Node "1" *-- "1" Map : has
Node "0..1" -- "1" LabelSuite : has
@enduml