@startuml
skinparam shadowing false
hide empty members
class PetriNet {
  name : String
  nets : String
  transitions : String
  +addPlace()
  +addArc()
}
class Net {
  name : String
  places : String
}
class Place {
  name : String
  net : String
}
class Transition {
  name : String
  net : String
  outgoingArcs : String
}
class PTArc {
  name : String
  srcPlace : String
  dstNet : String
}
class TPArc {
  name : String
  srcTransition : String
  dstTransition : String
}
PetriNet "1" -- "1" Net : has
PetriNet "1" -- "1..*" Place : has
PetriNet "1" -- "1..*" Transition : has
Net "1" -- "1..*" Place : has
Net "1" -- "0..*" TPArc : has
PTArc --|> TPArc
@enduml