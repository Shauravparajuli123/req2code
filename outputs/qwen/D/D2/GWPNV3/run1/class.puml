@startuml
skinparam shadowing false
hide empty members
class PetriNet {
  name : String
  nets : String
  transitions : String
  places : String
  +addPlace()
  +addTransition()
}
class Net {
  name : String
  places : String
}
class Place {
  name : String
  net : String
}
class Transition {
  name : String
  net : String
  outgoingArcs : String
}
class PTArc {
  name : String
  srcPlace : String
  dstTransition : String
}
class TPArc {
  name : String
  srcTransition : String
}
PetriNet "1" -- "1" Net : has
PTArc "0..*" -- "1" Place : has
PetriNet "1" -- "1" Transition : has
Net "1" *-- "1" Place : is composed of
PTArc "0..*" -- "0..*" TPArc : has
TPArc "0..*" -- "0..*" PTArc : has
PTArc "1" -- "1" Transition : has
TPArc "1" -- "1" Transition : has
@enduml