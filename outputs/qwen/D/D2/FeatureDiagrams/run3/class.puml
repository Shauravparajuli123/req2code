Node "1" -- "0..*" XORGroup : has
Node "1" -- "0..*" ORGroup : has
FeatureDiagram "1" -- "0..*" Node : has
Node "1" *-- "1" Attribute : is composed of
FeatureDiagram "1" o-- "0..*" Node : has
XORGroup "1" o-- "0..*" Node : has
ORGroup "1" o-- "0..*" Node : has
@enduml