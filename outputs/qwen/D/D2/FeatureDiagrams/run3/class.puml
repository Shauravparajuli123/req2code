@startuml
skinparam shadowing false
hide empty members
class Node {
  description : String
  object_ : String
  attribute : String
  children : String
  +addAttribute()
  +addChild()
}
class Attribute {
  description : String
  name : String
  key : boolean
  node : String
}
class FeatureDiagram {
  root : String
}
class XORGroup {
  preliminary : boolean
}
class ORGroup {
  preliminary : boolean
}
