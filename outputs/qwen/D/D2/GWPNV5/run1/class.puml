@startuml
skinparam shadowing false
hide empty members
class Place {
  name : String
  net : String
  inputArcs : String
  +addInputArc()
  +removeInputArc()
}
class Transition {
  name : String
  outputArcs : String
  +addOutputArc()
  +removeOutputArc()
}
class Arc {
  weight : int
  transition : String
  place : String
  +setWeight()
  +setTransition()
  +setPlace()
}
class Token {
  place : String
  +moveTo()
}
class Net {
  name : String
  places : String
  tokens : String
  +addPlace()
  +removePlace()
  +addToken()
  +removeToken()
}
Net "1" -- "0..*" Place : has
Net "1" -- "0..*" Transition : has
Arc "*" -- "1" Place : has
Arc "*" -- "1" Transition : has
Token "*" -- "1" Place : is in
@enduml