@startuml
skinparam shadowing false
hide empty members
class BusinessEntity {
  identifiers : String
  businessContacts : String
  services : String
}
class IdentifierBag {
  identifiers : String
}
class BusinessContact {
  contact : String
}
class Service {
  service : String
}
class Model {
  overviewDocuments : String
}
class OverviewDocument {
  document : String
}
class BusinessTemplate {
  template : String
}
BusinessEntity "1" -- "0..1" BusinessContact : has
BusinessEntity "1" -- "0..*" Service : provides
Model "1" o-- "0..*" OverviewDocument : contains
BusinessEntity --|> Model
@enduml