@startuml
skinparam shadowing false
hide empty members
class Airline {
  name : String
  operatingCosts : String
  +startOperation()
  +stopOperation()
  +updateOperatingCost()
}
class Airport {
  code : String
  city : String
}
class Details {
  operatingCost : double
}
Airline "1" -- "1..*" Airport : operates at
Airline "1" -- "1" Details : has
@enduml